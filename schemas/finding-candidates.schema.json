{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding-candidates.schema.json",
  "type": "array",
  "maxItems": 128,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "taxonomy", "path", "line", "title", "evidence", "rootCause", "level"],
    "properties": {
      "version": { "type": "string", "const": "v2" },
      "taxonomy": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]{1,500}$" },
      "line": { "type": "integer", "minimum": 1 },
      "title": { "type": "string", "minLength": 1, "maxLength": 180 },
      "evidence": { "type": "string", "minLength": 1, "maxLength": 6000 },
      "rootCause": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "level": { "type": "string", "enum": ["blocker", "major", "minor", "suggestion"] }
    }
  }
}
