{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2-evidence.schema.json",
  "description": "v2 runner 编排的 assignment 证据契约。完成判据 = 本文件按契约落盘;checkpoint 与 resume 只认这个判据。校验实现在 harness/evidence.mjs。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assignmentId", "mode", "worker", "headOid", "commands", "artifacts", "exitCodes", "verdict", "notes", "binaryProvenance"],
  "properties": {
    "version": { "type": "string", "const": "v2-evidence.1" },
    "assignmentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "mode": { "type": "string", "enum": ["static", "test", "probe", "adversarial"] },
    "worker": { "type": "string", "pattern": "^W[0-9]{1,2}$" },
    "headOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "证据绑定的被审 PR head;与权威 head 不符的证据一律无效(测的就是审的)。"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]{1,500}$" },
      "description": "evidence/<assignmentId>/ 下的相对路径(测试源码、命令输出、转录)。"
    },
    "exitCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "verdict": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "notes": { "type": "string", "maxLength": 4000 },
    "binaryProvenance": {
      "description": "artifact 出处铁律:被测二进制只能由本次 review pipeline 的 build-server job 从被审 PR head 现场编译。P1 的 test/static 模式没有二进制,必须为 null;probe 必须携带 {headOid, buildRunId} 且 headOid 与证据自身一致;不收本地上传、不复用其他 workflow 的既有二进制、不用手供产物。",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["headOid", "buildRunId"],
          "properties": {
            "headOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "buildRunId": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        }
      ]
    }
  }
}
