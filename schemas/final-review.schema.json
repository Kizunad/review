{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decision", "findings", "failures"],
  "properties": {
    "version": { "type": "string", "const": "v1" },
    "decision": { "type": "string", "enum": ["approve", "request_changes", "infrastructure_failure"] },
    "findings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taxonomy", "path", "line", "title", "evidence", "rootCause", "severity", "fingerprint"],
        "properties": {
          "taxonomy": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]{1,500}$" },
          "line": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 180 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 6000 },
          "rootCause": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "failures": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status", "error"],
        "properties": {
          "stage": { "type": "string", "minLength": 1, "maxLength": 300 },
          "status": { "type": "string", "enum": ["infra_error", "schema_error"] },
          "error": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    }
  }
}
