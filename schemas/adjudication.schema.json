{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adjudication.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "candidateFingerprint", "decision", "reason"],
  "properties": {
    "version": { "type": "string", "const": "v2" },
    "candidateFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "type": "string", "enum": ["accept", "reject"] },
    "level": { "type": "string", "enum": ["blocker", "major", "minor", "suggestion"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": { "const": "accept" }
        },
        "required": ["decision"]
      },
      "then": {
        "required": ["level"]
      },
      "else": {
        "not": { "required": ["level"] }
      }
    }
  ]
}
